              "background-image": "linear-gradient(315deg, @gradientColor -40%, transparent 50%, transparent 50%, @gradientColor 100%)"
            },
            ".title-wrapper": {
              "position": "relative",
              "z-index": "1",
              ".mbr-section-title": {
